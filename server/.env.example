# Copy to .env and fill in.

PORT=8600

# Local MongoDB.
MONGO_URI=mongodb://127.0.0.1:27017/portfolio

# Any long random string. `openssl rand -hex 32`
JWT_SECRET=change-me

# The account that signs up with this email becomes the admin (sees all requests,
# posts updates, changes status).
ADMIN_EMAIL=rudyhamameca@gmail.com

# Anthropic API key for the chatbot. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Cheaper options for a high-traffic FAQ bot: claude-haiku-4-5, claude-sonnet-5
CHAT_MODEL=claude-opus-5

# Use "openai", "anthropic", "ollama", or "auto".
CHAT_PROVIDER=auto
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Where the frontend is served from (CORS allowlist), comma-separated.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173,http://192.168.68.60:5173,http://192.168.68.60:4173
